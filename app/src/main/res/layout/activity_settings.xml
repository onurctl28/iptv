<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sync_section"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:text="@string/sync_section_help"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout style="@style/SettingRow">
            <TextView android:id="@+id/btn_sync_receive" style="@style/SettingChip" android:text="@string/sync_open_receive" />
            <TextView android:id="@+id/btn_sync_send" style="@style/SettingChip" android:text="@string/sync_open_send" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:background="#223049" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sub_appearance"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:text="@string/sub_help"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <!-- Önizleme -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="#101826">

            <TextView
                android:id="@+id/tv_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom"
                android:layout_marginBottom="16dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/sub_preview"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </FrameLayout>

        <TextView style="@style/SettingLabel" android:text="@string/sub_size" />
        <LinearLayout android:id="@+id/row_size" style="@style/SettingRow">
            <TextView android:id="@+id/size0" style="@style/SettingChip" android:text="@string/sz_small" />
            <TextView android:id="@+id/size1" style="@style/SettingChip" android:text="@string/sz_normal" />
            <TextView android:id="@+id/size2" style="@style/SettingChip" android:text="@string/sz_large" />
            <TextView android:id="@+id/size3" style="@style/SettingChip" android:text="@string/sz_xlarge" />
        </LinearLayout>

        <TextView style="@style/SettingLabel" android:text="@string/sub_color" />
        <LinearLayout style="@style/SettingRow">
            <TextView android:id="@+id/color0" style="@style/SettingChip" android:text="@string/col_white" />
            <TextView android:id="@+id/color1" style="@style/SettingChip" android:text="@string/col_yellow" />
        </LinearLayout>

        <TextView style="@style/SettingLabel" android:text="@string/sub_bg" />
        <LinearLayout style="@style/SettingRow">
            <TextView android:id="@+id/bg_on" style="@style/SettingChip" android:text="@string/on" />
            <TextView android:id="@+id/bg_off" style="@style/SettingChip" android:text="@string/off" />
        </LinearLayout>

        <TextView style="@style/SettingLabel" android:text="@string/sub_edge" />
        <LinearLayout style="@style/SettingRow">
            <TextView android:id="@+id/edge_on" style="@style/SettingChip" android:text="@string/on" />
            <TextView android:id="@+id/edge_off" style="@style/SettingChip" android:text="@string/off" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="#223049" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/os_title"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:text="@string/os_help"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_os_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input"
            android:hint="@string/os_key_hint"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/et_os_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input"
            android:hint="@string/os_user_hint"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/et_os_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input"
            android:hint="@string/os_pass_hint"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/et_os_lang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input"
            android:hint="@string/os_lang_hint"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <TextView
            android:id="@+id/btn_os_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="28dp"
            android:paddingVertical="12dp"
            android:text="@string/save"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
